# Логин и пароль репетитора. Только он создаёт комнаты и видит их пароли.
TUTOR_USERNAME=tutor
TUTOR_PASSWORD=change-this-tutor-password
TUTOR_NAME=Роман

# Один общий логин для всех учеников. В комнату их пускает уже пароль комнаты.
STUDENT_USERNAME=student
STUDENT_PASSWORD=change-this-student-password

# Длинная случайная строка. Сгенерировать:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-secret

# 1, если перед приложением стоит HTTPS (Caddy, nginx, сертификат).
COOKIE_SECURE=0

# Порт, который открыт на VPS.
PORT=8080
